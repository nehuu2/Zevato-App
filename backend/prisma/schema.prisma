generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  clerkUserId      String    @unique
  name             String
  email            String
  phone            String?
  avatarUrl        String?
  profileCompleted Boolean   @default(false)
  hasProtectionPlan Boolean  @default(false)
  memberSince      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses        Address[]
  bookings         Booking[]

  @@index([clerkUserId])
  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  street    String
  apartment String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]

  @@index([userId])
}

model Category {
  id          String   @id
  name        String
  icon        String
  iconFamily  String?  @default("Ionicons")
  description String
  popular     Boolean  @default(false)
  itemCount   Int      @default(0)
  createdAt   DateTime @default(now())

  products       Product[]
  serviceOptions ServiceOption[]
}

model Brand {
  id         String   @id
  name       String
  logo       String?
  categories String   // JSON array of category IDs
  createdAt  DateTime @default(now())

  products   Product[]
}

model Product {
  id           String    @id
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name         String
  model        String?
  image        String?
  description  String
  startingPrice Float?
  createdAt    DateTime  @default(now())

  @@index([categoryId])
  @@index([brandId])
}

model ServiceOption {
  id            String    @id
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  description   String
  duration      String
  price         Float
  originalPrice Float?
  rating        Float?    @default(4.8)
  reviewCount   Int?      @default(0)
  features      String    // JSON array
  included      String    // JSON array
  excluded      String    // JSON array
  warrantyDays  Int       @default(30)
  isPopular     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([categoryId])
}

model Technician {
  id               String    @id @default(cuid())
  name             String
  phone            String
  rating           Float     @default(4.9)
  completedJobs    Int       @default(0)
  experienceYears  Int       @default(3)
  specialization   String?   @default("Appliance Specialist")
  avatar           String?
  currentLatitude  Float?
  currentLongitude Float?
  available        Boolean   @default(true)
  createdAt        DateTime  @default(now())

  bookings         Booking[]
}

model Booking {
  id                     String    @id
  bookingNumber          String    @unique
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId             String
  categoryName           String
  brandName              String?
  productName            String?
  serviceOptionId        String
  serviceName            String
  selectedOptionSnapshot String    // JSON string of selected package
  addressId              String?
  address                Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  addressSnapshot        String    // JSON string of address at time of booking
  scheduledDate          String
  scheduledTimeSlot      String
  paymentMethod          String
  paymentStatus          String    @default("paid")
  bookingStatus          String    @default("confirmed")
  subtotal               Float
  discount               Float     @default(0)
  tax                    Float     @default(0)
  total                  Float
  notes                  String?
  cancellationReason     String?
  technicianId           String?
  technician             Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  statusHistory          BookingStatusHistory[]
  serviceReport          ServiceReport?
  invoice                Invoice?

  @@index([userId])
  @@index([bookingStatus])
  @@index([technicianId])
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  timestamp DateTime @default(now())

  @@index([bookingId])
}

model ServiceReport {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technicianNotes String
  partsReplaced   String?  // JSON array string
  warrantyUntil   String
  ratingGiven     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  subtotal      Float
  discount      Float    @default(0)
  taxableAmount Float
  cgst          Float
  sgst          Float
  total         Float
  paymentMethod String
  paymentStatus String   @default("paid")
  issuedAt      DateTime @default(now())
}
